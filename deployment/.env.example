DOMAIN=grc.10alytics.io
TAG=replace-with-canary-release-tag
CISO_ASSISTANT_URL=https://grc.10alytics.io
ALLOWED_HOSTS=backend,grc.10alytics.io
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-random-secret
AUTH_TOKEN_TTL=7200
GUNICORN_WORKERS=2
ENABLE_CHAT=False
POSTGRES_NAME=grc_pool_lab
POSTGRES_USER=grc_lab
POSTGRES_PASSWORD=replace-with-database-password
DB_HOST=replace-with-private-managed-postgres-host
DB_PORT=25060
POSTGRES_SSL_MODE=require
HOME=/tmp
XDG_CACHE_HOME=/tmp/.cache
XDG_CONFIG_HOME=/tmp/.config
XDG_DATA_HOME=/tmp/.local/share
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
